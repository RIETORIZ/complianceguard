{
  "name": "Owner",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "employee_number": {
      "type": "string"
    },
    "job_title": {
      "type": "string"
    },
    "work_email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "sector_id": {
      "type": "string"
    },
    "department_id": {
      "type": "string"
    },
    "division_id": {
      "type": "string"
    },
    "manager_id": {
      "type": "string",
      "description": "Manager owner id"
    },
    "group_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assigned_sites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assigned_systems": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assigned_controls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assigned_evidence_requests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_primary_accountable": {
      "type": "boolean",
      "default": false
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "full_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "System Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "System Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Officer"
          }
        },
        {
          "user_condition": {
            "role": "Auditor"
          }
        },
        {
          "user_condition": {
            "role": "Auditee"
          }
        },
        {
          "user_condition": {
            "role": "Control Owner"
          }
        },
        {
          "user_condition": {
            "role": "Department Manager"
          }
        },
        {
          "user_condition": {
            "role": "Division Manager"
          }
        },
        {
          "user_condition": {
            "role": "Sector Manager"
          }
        },
        {
          "user_condition": {
            "role": "External Auditor"
          }
        },
        {
          "user_condition": {
            "role": "Executive Viewer"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "System Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "System Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        }
      ]
    }
  }
}