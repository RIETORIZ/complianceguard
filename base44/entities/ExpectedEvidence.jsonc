{
  "name": "ExpectedEvidence",
  "type": "object",
  "properties": {
    "control_id": {
      "type": "string"
    },
    "framework_id": {
      "type": "string"
    },
    "evidence_type": {
      "type": "string",
      "description": "e.g. Approved Policy, Screenshot, Configuration Export"
    },
    "name": {
      "type": "string",
      "description": "Expected evidence name"
    },
    "description": {
      "type": "string"
    },
    "is_mandatory": {
      "type": "boolean",
      "default": true
    },
    "accepted_formats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validity_period_days": {
      "type": "number",
      "description": "Evidence validity in days"
    },
    "example": {
      "type": "string"
    },
    "requires_formal_approval": {
      "type": "boolean",
      "default": false
    },
    "allow_reuse": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "control_id",
    "name"
  ]
}