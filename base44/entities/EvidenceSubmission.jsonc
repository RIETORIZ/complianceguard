{
  "name": "EvidenceSubmission",
  "type": "object",
  "properties": {
    "evidence_request_id": {
      "type": "string"
    },
    "master_evidence_id": {
      "type": "string",
      "description": "Stable master id reused across versions"
    },
    "display_title": {
      "type": "string",
      "description": "Meaningful evidence title"
    },
    "original_file_name": {
      "type": "string"
    },
    "file_url": {
      "type": "string",
      "description": "Uploaded file storage location",
      "rls": {
        "read": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "System Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Officer"
              }
            },
            {
              "user_condition": {
                "role": "Auditor"
              }
            }
          ]
        },
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "System Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Officer"
              }
            },
            {
              "user_condition": {
                "role": "Auditor"
              }
            },
            {
              "user_condition": {
                "role": "Auditee"
              }
            },
            {
              "user_condition": {
                "role": "Control Owner"
              }
            }
          ]
        }
      }
    },
    "file_type": {
      "type": "string"
    },
    "file_size": {
      "type": "number"
    },
    "file_hash": {
      "type": "string",
      "description": "Integrity identifier"
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "is_active_version": {
      "type": "boolean",
      "default": true
    },
    "upload_date": {
      "type": "string",
      "format": "date-time"
    },
    "received_date": {
      "type": "string",
      "format": "date-time"
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "review_date": {
      "type": "string",
      "format": "date"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "confidentiality_classification": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ],
      "default": "confidential"
    },
    "owner_id": {
      "type": "string"
    },
    "uploaded_by_id": {
      "type": "string"
    },
    "linked_audit_control_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Controls this evidence supports (reuse)"
    },
    "linked_evidence_request_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checklist_completed": {
      "type": "boolean",
      "default": false
    },
    "checklist_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "condition": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          }
        }
      }
    },
    "review_history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "description": {
      "type": "string"
    },
    "evidence_type": {
      "type": "string"
    },
    "responsible_department_id": {
      "type": "string"
    },
    "related_system_id": {
      "type": "string"
    },
    "related_asset": {
      "type": "string"
    },
    "related_site_id": {
      "type": "string"
    },
    "evidence_date": {
      "type": "string",
      "format": "date"
    },
    "document_version": {
      "type": "string"
    },
    "approving_authority": {
      "type": "string"
    },
    "change_description": {
      "type": "string"
    },
    "superseded_date": {
      "type": "string",
      "format": "date-time"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "awaiting_review",
        "accepted",
        "accepted_with_observation",
        "rejected",
        "clarification_requested",
        "further_comments_requested",
        "corrected_file_requested",
        "updated_evidence_requested",
        "formal_approval_requested",
        "partially_sufficient"
      ],
      "default": "awaiting_review"
    },
    "review_comments": {
      "type": "string"
    },
    "rejection_reason": {
      "type": "string"
    },
    "reviewed_by_id": {
      "type": "string"
    },
    "acceptance_date": {
      "type": "string",
      "format": "date-time"
    },
    "rejection_date": {
      "type": "string",
      "format": "date-time"
    },
    "validity_status": {
      "type": "string",
      "enum": [
        "Valid",
        "Expiring Soon",
        "Expired",
        "Pending Renewal",
        "Superseded",
        "Under Review"
      ],
      "default": "Under Review"
    },
    "malware_scan_status": {
      "type": "string",
      "enum": [
        "not_scanned",
        "pending",
        "clean",
        "infected",
        "failed"
      ],
      "default": "not_scanned"
    },
    "review_decision": {
      "type": "string",
      "enum": [
        "Pending Review",
        "Accepted",
        "Accepted with Observation",
        "Partially Sufficient",
        "Revision Required",
        "Rejected",
        "Expired",
        "Superseded"
      ],
      "default": "Pending Review",
      "description": "Canonical evidence review decision. Kept separate from request and compliance status."
    }
  },
  "required": [
    "evidence_request_id",
    "display_title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "System Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Officer"
          }
        },
        {
          "user_condition": {
            "role": "Auditor"
          }
        },
        {
          "user_condition": {
            "role": "Auditee"
          }
        },
        {
          "user_condition": {
            "role": "Control Owner"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "System Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Officer"
          }
        },
        {
          "user_condition": {
            "role": "Auditor"
          }
        },
        {
          "user_condition": {
            "role": "Auditee"
          }
        },
        {
          "user_condition": {
            "role": "Control Owner"
          }
        },
        {
          "user_condition": {
            "role": "Department Manager"
          }
        },
        {
          "user_condition": {
            "role": "Division Manager"
          }
        },
        {
          "user_condition": {
            "role": "Sector Manager"
          }
        },
        {
          "user_condition": {
            "role": "External Auditor"
          }
        },
        {
          "user_condition": {
            "role": "Executive Viewer"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "System Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Officer"
          }
        },
        {
          "user_condition": {
            "role": "Auditor"
          }
        },
        {
          "user_condition": {
            "role": "Auditee"
          }
        },
        {
          "user_condition": {
            "role": "Control Owner"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "System Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        }
      ]
    }
  }
}
