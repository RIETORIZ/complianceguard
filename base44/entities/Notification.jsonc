{
  "name": "Notification",
  "type": "object",
  "properties": {
    "recipient_id": {
      "type": "string"
    },
    "recipient_email": {
      "type": "string"
    },
    "channel": {
      "type": "string",
      "enum": [
        "email",
        "in_app"
      ],
      "default": "in_app"
    },
    "delivery_mode": {
      "type": "string",
      "enum": [
        "immediate",
        "end_of_day"
      ],
      "default": "immediate"
    },
    "type": {
      "type": "string",
      "description": "e.g. new_evidence_request, upcoming_deadline, overdue, submission, rejection, revision_request, approval, evidence_expiration, finding, overdue_corrective_action, escalation"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "related_record_type": {
      "type": "string"
    },
    "related_record_id": {
      "type": "string"
    },
    "link": {
      "type": "string"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "read_at": {
      "type": "string",
      "format": "date-time"
    },
    "delivery_status": {
      "type": "string",
      "enum": [
        "queued",
        "sent",
        "delivered",
        "failed",
        "dev_logged"
      ],
      "default": "dev_logged"
    }
  },
  "required": [
    "title",
    "type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "System Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Officer"
          }
        },
        {
          "user_condition": {
            "role": "Auditor"
          }
        },
        {
          "user_condition": {
            "role": "Auditee"
          }
        },
        {
          "user_condition": {
            "role": "Control Owner"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "System Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Officer"
          }
        },
        {
          "user_condition": {
            "role": "Auditor"
          }
        },
        {
          "user_condition": {
            "role": "Auditee"
          }
        },
        {
          "user_condition": {
            "role": "Control Owner"
          }
        },
        {
          "user_condition": {
            "role": "Department Manager"
          }
        },
        {
          "user_condition": {
            "role": "Division Manager"
          }
        },
        {
          "user_condition": {
            "role": "Sector Manager"
          }
        },
        {
          "user_condition": {
            "role": "External Auditor"
          }
        },
        {
          "user_condition": {
            "role": "Executive Viewer"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "System Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Officer"
          }
        },
        {
          "user_condition": {
            "role": "Auditor"
          }
        },
        {
          "user_condition": {
            "role": "Auditee"
          }
        },
        {
          "user_condition": {
            "role": "Control Owner"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "System Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        }
      ]
    }
  }
}