{
  "name": "Domain",
  "type": "object",
  "properties": {
    "framework_id": {
      "type": "string",
      "description": "Reference to Framework"
    },
    "name": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "parent_id": {
      "type": "string",
      "description": "Optional parent domain for subdomain hierarchy"
    }
  },
  "required": [
    "framework_id",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "System Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "System Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Officer"
          }
        },
        {
          "user_condition": {
            "role": "Auditor"
          }
        },
        {
          "user_condition": {
            "role": "Auditee"
          }
        },
        {
          "user_condition": {
            "role": "Control Owner"
          }
        },
        {
          "user_condition": {
            "role": "Department Manager"
          }
        },
        {
          "user_condition": {
            "role": "Division Manager"
          }
        },
        {
          "user_condition": {
            "role": "Sector Manager"
          }
        },
        {
          "user_condition": {
            "role": "External Auditor"
          }
        },
        {
          "user_condition": {
            "role": "Executive Viewer"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "System Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "System Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        }
      ]
    }
  }
}