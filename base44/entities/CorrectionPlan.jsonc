{
  "name": "CorrectionPlan",
  "type": "object",
  "properties": {
    "corrective_action": {
      "type": "string"
    },
    "finding_id": {
      "type": "string"
    },
    "audit_id": {
      "type": "string"
    },
    "control_id": {
      "type": "string"
    },
    "primary_owner_id": {
      "type": "string"
    },
    "supporting_owner_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "target_date": {
      "type": "string",
      "format": "date"
    },
    "completion_percentage": {
      "type": "number",
      "default": 0
    },
    "required_closure_evidence": {
      "type": "string"
    },
    "submitted_closure_evidence_url": {
      "type": "string"
    },
    "validation_comments": {
      "type": "string"
    },
    "escalation_level": {
      "type": "number",
      "default": 0
    },
    "closure_decision": {
      "type": "string",
      "enum": [
        "Pending",
        "Verified",
        "Partially Verified",
        "Closure Evidence Rejected",
        "Technical Validation Required",
        "Risk Accepted",
        "Cancelled"
      ],
      "default": "Pending"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Awaiting Owner Response",
        "Open",
        "In Progress",
        "Pending Closure Evidence",
        "Submitted for Verification",
        "Revision Required",
        "Verified",
        "Closed",
        "Overdue",
        "On Hold",
        "Cancelled",
        "Risk Accepted"
      ],
      "default": "Awaiting Owner Response"
    },
    "gap_description": {
      "type": "string"
    },
    "root_cause": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "status_history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "status_reason": {
      "type": "string"
    },
    "risk_acceptance_expiry": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "corrective_action"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "System Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Officer"
          }
        },
        {
          "user_condition": {
            "role": "Auditor"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "System Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Officer"
          }
        },
        {
          "user_condition": {
            "role": "Auditor"
          }
        },
        {
          "user_condition": {
            "role": "Auditee"
          }
        },
        {
          "user_condition": {
            "role": "Control Owner"
          }
        },
        {
          "user_condition": {
            "role": "Department Manager"
          }
        },
        {
          "user_condition": {
            "role": "Division Manager"
          }
        },
        {
          "user_condition": {
            "role": "Sector Manager"
          }
        },
        {
          "user_condition": {
            "role": "External Auditor"
          }
        },
        {
          "user_condition": {
            "role": "Executive Viewer"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "System Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Officer"
          }
        },
        {
          "user_condition": {
            "role": "Auditor"
          }
        },
        {
          "user_condition": {
            "role": "Auditee"
          }
        },
        {
          "user_condition": {
            "role": "Control Owner"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "System Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        }
      ]
    }
  }
}
