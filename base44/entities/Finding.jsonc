{
  "name": "Finding",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "source_audit_id": {
      "type": "string"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "Regulatory Audit",
        "Internal Audit",
        "External Audit",
        "Corporate Assessment",
        "Technical Assessment",
        "Evidence Review",
        "Risk Assessment",
        "Control Testing",
        "Continuous Compliance Monitoring"
      ],
      "default": "Evidence Review"
    },
    "framework_id": {
      "type": "string"
    },
    "control_id": {
      "type": "string"
    },
    "audit_control_id": {
      "type": "string"
    },
    "evidence_request_id": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "risk_rating": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "regulatory_impact": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "department_id": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "auditor_comments": {
      "type": "string"
    },
    "management_response": {
      "type": "string"
    },
    "closure_evidence_url": {
      "type": "string"
    },
    "verification_result": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Open",
        "Management Response Required",
        "Correction Plan Required",
        "Under Remediation",
        "Pending Verification",
        "Closed",
        "Risk Accepted",
        "Cancelled"
      ],
      "default": "Draft"
    },
    "status_history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "cancellation_reason": {
      "type": "string"
    },
    "risk_acceptance_expiry": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "System Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Officer"
          }
        },
        {
          "user_condition": {
            "role": "Auditor"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "System Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Officer"
          }
        },
        {
          "user_condition": {
            "role": "Auditor"
          }
        },
        {
          "user_condition": {
            "role": "Auditee"
          }
        },
        {
          "user_condition": {
            "role": "Control Owner"
          }
        },
        {
          "user_condition": {
            "role": "Department Manager"
          }
        },
        {
          "user_condition": {
            "role": "Division Manager"
          }
        },
        {
          "user_condition": {
            "role": "Sector Manager"
          }
        },
        {
          "user_condition": {
            "role": "External Auditor"
          }
        },
        {
          "user_condition": {
            "role": "Executive Viewer"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "System Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Officer"
          }
        },
        {
          "user_condition": {
            "role": "Auditor"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "System Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        }
      ]
    }
  }
}
