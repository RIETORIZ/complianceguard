{
  "name": "EvidenceMapping",
  "type": "object",
  "properties": {
    "master_evidence_id": {
      "type": "string"
    },
    "evidence_submission_id": {
      "type": "string"
    },
    "evidence_request_id": {
      "type": "string"
    },
    "audit_control_id": {
      "type": "string"
    },
    "control_id": {
      "type": "string"
    },
    "mapping_type": {
      "type": "string",
      "enum": [
        "primary",
        "reuse"
      ],
      "default": "reuse"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "pending",
        "awaiting_review",
        "accepted",
        "accepted_with_observation",
        "rejected",
        "partially_sufficient",
        "clarification_requested",
        "further_comments_requested",
        "corrected_file_requested",
        "updated_evidence_requested",
        "formal_approval_requested",
        "expired",
        "superseded"
      ],
      "default": "pending"
    },
    "review_comments": {
      "type": "string"
    },
    "reviewed_by_id": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_decision": {
      "type": "string",
      "enum": [
        "Pending Review",
        "Accepted",
        "Accepted with Observation",
        "Partially Sufficient",
        "Revision Required",
        "Rejected",
        "Expired",
        "Superseded"
      ],
      "default": "Pending Review",
      "description": "Canonical evidence review decision. Kept separate from request and compliance status."
    },
    "mapping_status": {
      "type": "string",
      "enum": [
        "Pending",
        "Active",
        "Revision Required",
        "Rejected",
        "Expired",
        "Superseded"
      ],
      "default": "Pending",
      "description": "Lifecycle of this evidence-to-control mapping, separate from the auditor review decision."
    }
  },
  "required": [
    "master_evidence_id",
    "evidence_submission_id",
    "evidence_request_id",
    "audit_control_id",
    "mapping_status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "System Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Officer"
          }
        },
        {
          "user_condition": {
            "role": "Auditor"
          }
        },
        {
          "user_condition": {
            "role": "Auditee"
          }
        },
        {
          "user_condition": {
            "role": "Control Owner"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "System Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Officer"
          }
        },
        {
          "user_condition": {
            "role": "Auditor"
          }
        },
        {
          "user_condition": {
            "role": "Auditee"
          }
        },
        {
          "user_condition": {
            "role": "Control Owner"
          }
        },
        {
          "user_condition": {
            "role": "Department Manager"
          }
        },
        {
          "user_condition": {
            "role": "Division Manager"
          }
        },
        {
          "user_condition": {
            "role": "Sector Manager"
          }
        },
        {
          "user_condition": {
            "role": "External Auditor"
          }
        },
        {
          "user_condition": {
            "role": "Executive Viewer"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "System Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Officer"
          }
        },
        {
          "user_condition": {
            "role": "Auditor"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "System Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        }
      ]
    }
  }
}
