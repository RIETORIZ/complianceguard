{
  "name": "EvidenceCondition",
  "type": "object",
  "properties": {
    "expected_evidence_id": {
      "type": "string"
    },
    "control_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Condition text e.g. Meaningful file name"
    },
    "description": {
      "type": "string"
    },
    "is_mandatory": {
      "type": "boolean",
      "default": true
    },
    "accepted_formats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validity_period_days": {
      "type": "number"
    },
    "example": {
      "type": "string"
    },
    "common_rejection_reason": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "expected_evidence_id",
    "name"
  ]
}