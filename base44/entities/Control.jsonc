{
  "name": "Control",
  "type": "object",
  "properties": {
    "framework_id": {
      "type": "string"
    },
    "domain_id": {
      "type": "string"
    },
    "parent_id": {
      "type": "string",
      "description": "Parent control for sub-control hierarchy"
    },
    "control_number": {
      "type": "string",
      "description": "e.g. 1-X-X"
    },
    "title": {
      "type": "string"
    },
    "official_text": {
      "type": "string",
      "description": "Protected official regulatory wording - never overwritten",
      "rls": {
        "read": true,
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "System Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Administrator"
              }
            }
          ]
        }
      }
    },
    "internal_notes": {
      "type": "string"
    },
    "implementation_guidance": {
      "type": "string"
    },
    "additional_requirements": {
      "type": "string"
    },
    "control_type": {
      "type": "string",
      "enum": [
        "regulatory",
        "custom"
      ],
      "default": "regulatory"
    },
    "is_custom": {
      "type": "boolean",
      "default": false
    },
    "applicable_sites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "applicable_systems": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "custom_requirement_text": {
      "type": "string",
      "description": "Organization-specific or custom requirement text"
    }
  },
  "required": [
    "framework_id",
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "System Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "System Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Officer"
          }
        },
        {
          "user_condition": {
            "role": "Auditor"
          }
        },
        {
          "user_condition": {
            "role": "Auditee"
          }
        },
        {
          "user_condition": {
            "role": "Control Owner"
          }
        },
        {
          "user_condition": {
            "role": "Department Manager"
          }
        },
        {
          "user_condition": {
            "role": "Division Manager"
          }
        },
        {
          "user_condition": {
            "role": "Sector Manager"
          }
        },
        {
          "user_condition": {
            "role": "External Auditor"
          }
        },
        {
          "user_condition": {
            "role": "Executive Viewer"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "System Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "System Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        }
      ]
    }
  }
}